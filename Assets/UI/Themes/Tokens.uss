/* Design tokens — all screens/components must use these variables. */
:root {
    --color-bg: #0b1220;
    --color-surface: #142033;
    --color-surface-raised: #1c2d45;
    --color-border: #2a3f5c;
    --color-text: #e8eef7;
    --color-text-muted: #8fa3bf;
    --color-accent: #2ec4b6;
    --color-accent-hover: #3dd9ca;
    --color-danger: #e85d5d;
    --color-warning: #f0b429;
    --color-success: #3ecf8e;

    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 16px;
    --space-lg: 24px;
    --space-xl: 32px;

    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;

    --font-title: 28px;
    --font-subtitle: 20px;
    --font-body: 16px;
    --font-caption: 13px;

    --transition-fast: 0.15s ease-out;
    --transition-normal: 0.25s ease-out;
}
