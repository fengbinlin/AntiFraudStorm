/* Design tokens — all screens/components must use these variables. */
:root {
    --color-bg: #0b1220;
    --color-surface: #142033;
    --color-surface-raised: #1c2d45;
    --color-border: #2a3f5c;
    --color-text: #e8eef7;
    --color-text-muted: #8fa3bf;
    --color-accent: #2ec4b6;
    --color-accent-hover: #3dd9ca;
    --color-danger: #e85d5d;
    --color-warning: #f0b429;
    --color-success: #3ecf8e;

    --color-hud-cyan-soft: #d4e8ff;
    --color-hud-cyan: #9ec9ff;
    --color-hud-cyan-mid: #6eb0f5;
    --color-hud-cyan-deep: #3d8fd9;
    --color-hud-text: #ffffff;
    --font-hud: url("project://database/Assets/UI/Fonts/MaokenZhuyuanTi.asset");
    --color-hud-panel: rgba(11, 18, 32, 0.45);
    --color-transparent: rgba(0, 0, 0, 0);
    --color-coin: #f0b429;
    --color-coin-deep: #d4921a;

    --space-xs: 4px;
    --space-sm: 8px;
    --space-md: 16px;
    --space-lg: 24px;
    --space-xl: 32px;
    --space-xxl: 64px;
    --space-hud-quest-gap: 96px;
    --size-hud-coin: 108px;
    --size-hud-action: 92px;
    --size-hud-action-icon: 84px;
    --size-hud-quest-marker: 48px;

    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --radius-xl: 26px;
    --radius-pill: 999px;

    /* Virtual desktop (cute sky-blue) */
    --color-desk-sky-top: #b8e0ff;
    --color-desk-sky-bot: #7ec8f8;
    --color-desk-cloud: rgba(255, 255, 255, 0.55);
    --color-desk-panel: rgba(255, 255, 255, 0.88);
    --color-desk-panel-solid: #f4faff;
    --color-desk-ink: #1a3a5c;
    --color-desk-ink-soft: #4a7194;
    --color-desk-accent: #3d8fd9;
    --color-desk-accent-hot: #5aa8f0;
    --color-desk-accent-deep: #2a6fb0;
    --color-desk-taskbar: rgba(46, 132, 196, 0.84);
    --color-desk-taskbar-edge: rgba(210, 236, 255, 0.45);
    --color-desk-taskbar-text: #f7fbff;
    --color-desk-danger-soft: #ffe0e4;
    --color-desk-ok-soft: #d8f8e8;
    --size-desk-icon: 128px;
    --size-desk-icon-glyph: 72px;
    --size-desk-portrait: 720px;
    --size-desk-portrait-half: 360px;
    --color-desk-portrait-hero: #F2C72E;
    --color-desk-portrait-thief: #3A1458;
    --radius-desk: 18px;
    --radius-desk-window: 22px;

    --font-title: 28px;
    --font-subtitle: 20px;
    --font-body: 16px;
    --font-caption: 13px;
    --font-hud-title: 36px;
    --font-hud-coin: 52px;
    --font-hud-body: 26px;
    --font-hud-caption: 20px;

    --transition-fast: 0.15s;
    --transition-normal: 0.25s;
}
